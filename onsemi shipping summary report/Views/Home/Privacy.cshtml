@model List<onsemi_shipping_summary_report.Models.ProductionOrder>

@{

    // ViewData["Title"] = "Privacy Policy";
    int currentPage = ViewBag.CurrentPage;
    int pageSize = ViewBag.PageSize;
    int totalRecords = ViewBag.TotalRecords;
    int totalPages = (int)Math.Ceiling((double)totalRecords / pageSize);
}

<div class="container">
    <!-- Pagination Links -->
    <ul class="nav nav-pills mb-4">
        <li class="nav-item">
            <a class="nav-link active" id="report1-tab" data-bs-toggle="pill" href="#report1">DIEPREP DUMP</a>
        </li>
        <li class="nav-item">
            <a class="nav-link" id="report2-tab" data-bs-toggle="pill" href="#report2">ASSY DUMP</a>
        </li>
    </ul>

    <div class="tab-content">
        <!-- Report 1 -->
        <div class="tab-pane fade show active" id="report1">
            <div class="card mb-5">
                <div class="card-header">
                    <strong>GEM DIEPREP DUMP</strong>
                </div>
                <div class="card-body">

                    <table class="table table-bordered">
                        <thead>
                            <tr>
                                <th>Lot Number</th>
                                <th>Order Date</th>
                                <th>Work Order</th>
                                <th>ATEC WO</th>
                                <th>SO</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var order in Model)
                            {
                                <tr>
                                    <td>@order.Lotnumber</td>
                                    <td>@order.OrderDate.ToString("yyyy-MM-dd")</td>
                                    <td>@order.workorder</td>
                                    <td>@order.ATEC_WO</td>
                                    <td>@order.SO</td>
                                </tr>
                            }
                        </tbody>
                    </table>

                    <div class="pagination">
                        @if (currentPage > 1)
                        {
                            <a href="@Url.Action("Privacy", new { pageNumber = currentPage - 1, pageSize = pageSize })">Previous</a>
                        }

                        @for (int i = 1; i <= totalPages; i++)
                        {
                            <a href="@Url.Action("Privacy", new { pageNumber = i, pageSize = pageSize })" class="@(i == currentPage ? "active" : "")">@i</a>
                        }

                        @if (currentPage < totalPages)
                        {
                            <a href="@Url.Action("Privacy", new { pageNumber = currentPage + 1, pageSize = pageSize })">Next</a>
                        }
                    </div>
                </div>
              
            </div>
        </div>
        <!-- Report  2-->
        <div class="tab-pane fade" id="report2">
            <div class="card mb-5">
                <div class="card-header">
                    <strong>GEM Checker</strong>
                </div>
                <div class="card-body">
                    <form asp-controller="Home" asp-action="SearchGemAssy" method="get" class="mt-4">
                        <div class="row">
                            <div class="col-md-4">
                                <input id="SearchDevice" name="lotnumber" class="form-control" placeholder="Enter Lotnumber: " />
                            </div>
                            <div class="col-md-2">
                                <button type="submit" class="btn btn-primary">Search</button
                            </div>
                        </div>
                    </form>
                    <div class="mt-3">
                        @if (TempData["SuccessMessage"] != null)
                        {
                            <div class="alert alert-success">
                                @TempData["SuccessMessage"]
                            </div>
                        }
                        @if (TempData["ErrorMessage"] != null)
                        {
                            <div class="alert alert-danger">
                                @TempData["ErrorMessage"]
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
